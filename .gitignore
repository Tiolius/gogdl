# Track project files explicitly. GOG downloads can create arbitrary directories.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE-gogrepoc.txt
!/requirements.txt
!/Setup-GOGDL.cmd
!/Start-GOGDL.cmd
!/gogdl_backend.py
!/gogdl_settings.py
!/gogdl_window.py
!/gogrepoc.py
!/ui/
!/assets/
/ui/*
!/ui/app.ts
!/ui/tsconfig.json
/assets/*
!/assets/app.css
!/assets/app.js
!/assets/index.html
!/assets/Inter-Bold.ttf
!/assets/Inter-Regular.ttf
!/assets/Inter-OFL.txt
!/assets/JetBrainsMono-Regular.ttf
!/assets/JetBrainsMono-OFL.txt
!/assets/Material-Symbols-LICENSE.txt
!/assets/material/
/assets/material/*
!/assets/material/*.svg
